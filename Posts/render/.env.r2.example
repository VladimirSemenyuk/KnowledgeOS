# Cloudflare R2 для upload.py. Скопировать в .env.r2 (в git не попадает) и заполнить.
# Account ID — R2 → Overview, справа «Account Details».
R2_ACCOUNT_ID=
# R2 → Manage API tokens → Create API token: Object Read & Write, только этот бакет.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=semenyuk-media
# Бакет → Settings → Public Development URL → Allow; вида https://pub-xxxx.r2.dev
R2_PUBLIC_URL=
